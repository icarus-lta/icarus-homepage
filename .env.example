# Copy to .env in the repository root. Never put these values in frontend code.
# Recipient is fixed in the server: contact@icarus-airship.com
ICARUS_SMTP_HOST=smtp.daum.net
ICARUS_SMTP_PORT=465
# starttls for port 587, ssl for port 465. Unencrypted SMTP is not supported.
ICARUS_SMTP_SECURITY=ssl
# Use the login ID shown in Daum Mail > Settings > IMAP/POP3.
ICARUS_SMTP_USERNAME=
# Generate a dedicated app password; do not use your normal account password.
ICARUS_SMTP_PASSWORD=
# An address your SMTP account is allowed to send from.
ICARUS_MAIL_FROM=contact@icarus-airship.com
# Maximum size of the final encoded email, including all attachments.
# Set to your provider's actual limit. This default allows two 10 MB files.
ICARUS_MAIL_MAX_BYTES=30000000
# Only enable behind local cloudflared; start-cloudflare.sh sets this for you.
ICARUS_TRUST_CLOUDFLARE_PROXY=false
