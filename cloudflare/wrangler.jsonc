{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icarus-homepage",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*.mp4"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "SITE_ORIGIN": "https://icarus-homepage.icarus-airship.workers.dev",
    "MAIL_FROM": "ICARUS Website <website@icarus-airship.com>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFJC9620ubuERP3b"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "icarus-forms",
      "database_id": "a7732666-e7e0-4870-9b07-668e45d419a8",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "account_id": "985e88732c5fb9f553dc4d7a2f07f823",
  "kv_namespaces": [
    {
      "binding": "UPLOADS",
      "id": "1351dd968f6045d190a7577c27bbe642"
    }
  ]
}
