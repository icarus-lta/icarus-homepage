{
  "name": "icarus-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "wrangler dev --local",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run build && npm test && wrangler deploy --dry-run",
    "deploy": "node scripts/check-config.mjs && npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.143.0",
    "miniflare": "5.20260926.0-alpha",
    "esbuild": "0.28.1"
  },
  "overrides": { "undici": "7.29.1" }
}
