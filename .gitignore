# design-system package: dependencies and build output (rebuilt by `npm run build`)
design-system/node_modules/
design-system/dist/
design-system/generated/
design-system/src/generated/

# design-sync (Claude Design): staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Local design proposals, screenshots, and browser verification artifacts
/output/
/tmp/

# Windows alternate-data-stream leftovers from dragging files into WSL
*:Zone.Identifier

# Server-only mail configuration and Python environment
.env
.env.local
.venv/
__pycache__/
*.pyc

# Cloudflare: private configuration, local data, dependencies and generated files
cloudflare/node_modules/
cloudflare/.wrangler/
cloudflare/.dev.vars
cloudflare/.dev.vars.*
!cloudflare/.dev.vars.example
cloudflare/public/
cloudflare/generated/
cloudflare/test-output/
